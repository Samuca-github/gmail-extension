{
  "manifest_version": 3,
  "name": "Phishing Scanner (Gmail)",
  "version": "0.2.0",
  "description": "Login com Google via Supabase, le headers SPF/DMARC/DKIM da Gmail API e envia para a Analyze API.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["identity", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://fmpsqygpdujikcqsuvke.supabase.co/*",
    "https://mail.google.com/*",
    "http://localhost/*",
    "https://api-analize.onrender.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
